\setbeamertemplate{itemize items}{\textbullet}
\setbeamertemplate{blocks}[rounded][shadow=false]
\setbeamertemplate{frametitle}{\vspace{0.6em}\insertframetitle\par\vspace{0.15em}{\color{black}\rule{\textwidth}{0.6pt}}}
\setbeamertemplate{footline}{\hfill{\scriptsize\insertframenumber\,/\,\inserttotalframenumber}\hspace{1em}\vspace{0.6em}}

\definecolor{resalta}{gray}{0.82}
\tikzset{
  nodo/.style={circle, draw, thick, minimum size=7mm, inner sep=0pt, font=\small\bfseries, fill=white},
  fuente/.style={nodo, fill=gray!25},
  sumidero/.style={nodo, double, fill=gray!25},
  arco/.style={-{Stealth[length=2.2mm]}, thick},
  camino/.style={-{Stealth[length=2.6mm]}, line width=2.2pt},
  corte/.style={very thick, dashed},
  etq/.style={fill=white, inner sep=1pt, font=\scriptsize},
}
\newcommand{\res}[1]{\colorbox{resalta}{$\displaystyle #1$}}
\newcommand{\asg}[1]{\tikz[baseline=(c.base)]\node[draw, circle, thick, inner sep=1.2pt] (c) {#1};}
% Captura de la calculadora; si todavía no existe, deja un recuadro.
\newcommand{\captura}[2][0.82\textheight]{\IfFileExists{capturas/#2.png}{\includegraphics[height=#1, width=\textwidth, keepaspectratio]{capturas/#2.png}}{\fbox{\parbox[c][#1][c]{0.8\textwidth}{\centering Captura de la calculadora (#2)}}}}
